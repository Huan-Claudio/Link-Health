# Copie este arquivo para .env, gere suas próprias chaves e nunca envie .env ao Git.
# Para desenvolver sem banco, mantenha o perfil local. Troque para postgres quando
# as variáveis do banco estiverem preenchidas.
SPRING_PROFILES_ACTIVE=local
LINK_HEALTH_DB_URL=
LINK_HEALTH_DB_USERNAME=
LINK_HEALTH_DB_PASSWORD=
LINK_HEALTH_API_KEY=
LINK_HEALTH_PHOTOS_ENCRYPTION_KEY=
LINK_HEALTH_ALLOWED_ORIGINS=
LINK_HEALTH_REQUIRE_HTTPS=false
