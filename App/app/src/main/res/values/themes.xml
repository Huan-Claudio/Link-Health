<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- O app segue o design escuro do Figma, então usamos sempre o tema Dark. -->
    <style name="Base.Theme.App" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/lh_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/lh_green</item>
        <item name="colorSurface">@color/lh_surface</item>
        <item name="colorOnSurface">@color/lh_text_primary</item>
        <item name="android:colorBackground">@color/lh_background</item>
        <item name="android:windowBackground">@color/lh_background</item>
        <item name="android:textColorPrimary">@color/lh_text_primary</item>
        <item name="android:textColorSecondary">@color/lh_text_secondary</item>
        <item name="android:textColorHint">@color/lh_text_hint</item>
    </style>

    <style name="Theme.App" parent="Base.Theme.App" />

    <!-- ===== Textos ===== -->
    <style name="LH.Text" parent="">
        <item name="android:textColor">@color/lh_text_primary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="LH.Text.Title">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="LH.Text.CardTitle">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="LH.Text.Section">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="LH.Text.Body">
        <item name="android:textSize">13sp</item>
    </style>

    <style name="LH.Text.Caption">
        <item name="android:textColor">@color/lh_text_secondary</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="LH.Text.Label">
        <item name="android:textColor">@color/lh_text_secondary</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:layout_marginBottom">6dp</item>
    </style>

    <!-- ===== Campos de texto ===== -->
    <!-- Caixa com aparência de campo, usada também para exibir valores somente leitura -->
    <style name="LH.Value" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/lh_input_height</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">@color/lh_text_primary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="LH.Input" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/lh_input_height</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textColor">@color/lh_text_primary</item>
        <item name="android:textColorHint">@color/lh_text_hint</item>
        <item name="android:textSize">13sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:inputType">text</item>
    </style>

    <!-- ===== Botões ===== -->
    <style name="LH.Button" parent="Widget.Material3.Button">
        <item name="android:layout_height">@dimen/lh_button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/lh_primary</item>
        <item name="cornerRadius">@dimen/lh_radius_small</item>
    </style>

    <style name="LH.Button.Small">
        <item name="android:layout_height">40dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
    </style>

    <style name="LH.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_height">@dimen/lh_button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/lh_primary_light</item>
        <item name="backgroundTint">@color/lh_surface</item>
        <item name="strokeColor">@color/lh_primary</item>
        <item name="cornerRadius">@dimen/lh_radius_small</item>
    </style>

    <!-- ===== Containers ===== -->
    <style name="LH.Card" parent="">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">@dimen/lh_card_padding</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="LH.Progress" parent="Widget.Material3.LinearProgressIndicator">
        <item name="trackThickness">8dp</item>
        <item name="trackCornerRadius">4dp</item>
        <item name="indicatorColor">@color/lh_green</item>
        <item name="trackColor">@color/lh_input</item>
        <item name="trackStopIndicatorSize">0dp</item>
        <item name="indicatorTrackGapSize">0dp</item>
    </style>
</resources>
