<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/LH.CardView" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">
        <TextView android:id="@+id/tvShoppingStatus" style="@style/LH.Text.Caption"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
        <EditText android:id="@+id/etShoppingName" style="@style/LH.Input"
            android:layout_marginTop="8dp" android:hint="Nome do item" android:maxLength="120"
            android:importantForAutofill="no" android:inputType="textCapSentences" />
        <EditText android:id="@+id/etShoppingQuantity" style="@style/LH.Input"
            android:layout_marginTop="8dp" android:hint="Quantidade" android:maxLength="13"
            android:importantForAutofill="no" android:inputType="numberDecimal" />
        <TextView style="@style/LH.Text.Label" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Unidade" />
        <Spinner android:id="@+id/spShoppingUnit" android:layout_width="match_parent"
            android:layout_height="48dp" android:contentDescription="Unidade de medida" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnShoppingSave"
            style="@style/LH.Button" android:layout_width="match_parent" android:layout_marginTop="8dp"
            android:text="Salvar item" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnShoppingDelete"
            style="@style/LH.Button.Outlined" android:layout_width="match_parent" android:layout_marginTop="8dp"
            android:text="Remover item" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
