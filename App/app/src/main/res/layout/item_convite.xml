<?xml version="1.0" encoding="utf-8"?>
<!-- Linha com avatar + nome + botão "+" (convites / busca de paciente) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:layout_marginBottom="@dimen/lh_space_s"
    android:background="@drawable/bg_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="10dp">

    <TextView
        android:id="@+id/tvAvatar"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_circle_gray"
        android:gravity="center"
        android:textColor="@color/white"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvNome"
        style="@style/LH.Text.Body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:textStyle="bold"
        tools:text="Dr. Welington" />

    <ImageButton
        android:id="@+id/btnAdicionar"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="@drawable/bg_small_button"
        android:contentDescription="@string/adicionar_item_lista"
        android:padding="6dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_add"
        app:tint="@color/white" />
</LinearLayout>
