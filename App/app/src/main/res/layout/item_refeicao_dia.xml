<?xml version="1.0" encoding="utf-8"?>
<!-- Refeição dentro do card do "Registro diário": nome da refeição do plano, os alimentos da refeição
     (feita ou não) e o ícone verde (feita) ou vermelho (não feita). -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_input"
    android:minHeight="44dp"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="8dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/tvNomeRefeicao"
        style="@style/LH.Text.Body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/ivStatus"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Café da manhã" />

    <TextView
        android:id="@+id/tvAlimentosRefeicao"
        style="@style/LH.Text.Body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="8dp"
        android:textColor="@color/lh_text_secondary"
        android:visibility="gone"
        app:layout_constraintEnd_toStartOf="@id/ivStatus"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvNomeRefeicao"
        tools:text="• 2 ovos mexidos\n• 1 fatia de pão integral"
        tools:visibility="visible" />

    <ImageView
        android:id="@+id/ivStatus"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_check_circle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="ContentDescription" />
</androidx.constraintlayout.widget.ConstraintLayout>
