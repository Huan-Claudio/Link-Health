<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: "Linha do tempo de evolução" (paciente com câmera / nutricionista sem câmera) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lh_background"
    android:orientation="vertical"
    android:paddingStart="@dimen/lh_screen_padding"
    android:paddingTop="@dimen/lh_screen_padding"
    android:paddingEnd="@dimen/lh_screen_padding"
    tools:context=".ui.comum.EvolucaoCorporalActivity">

    <include layout="@layout/view_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/lh_screen_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/btnTirarFoto"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:background="@drawable/bg_dashed"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_camera"
                    app:tint="@color/lh_primary_light" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/tirar_foto"
                    android:textColor="@color/lh_primary_light"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/LH.Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/tirar_foto_desc" />
            </LinearLayout>

            <TextView
                style="@style/LH.Text.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/lh_space_l"
                android:layout_marginBottom="@dimen/lh_space_m"
                android:text="@string/historico_evolucao" />

            <!-- Grade de fotos (2 colunas) montada via código -->
            <LinearLayout
                android:id="@+id/containerFotos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
