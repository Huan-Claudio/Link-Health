<?xml version="1.0" encoding="utf-8"?>
<!-- Card "Resumo de Hoje" (refeições concluídas) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/LH.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/lh_space_m">

    <TextView
        style="@style/LH.Text.CardTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/resumo_de_hoje" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressRefeicoes"
        style="@style/LH.Progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp" />

    <TextView
        android:id="@+id/tvRefeicoesConcluidas"
        style="@style/LH.Text.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />
</LinearLayout>
