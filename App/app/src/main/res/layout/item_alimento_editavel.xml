<?xml version="1.0" encoding="utf-8"?>
<!-- Linha editável com lixeira (alimento do plano ou item da lista de compras) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="46dp"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_input"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingEnd="10dp">

    <EditText
        android:id="@+id/etAlimento"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@android:color/transparent"
        android:hint="@string/hint_alimento"
        android:importantForAutofill="no"
        android:inputType="textCapSentences"
        android:maxLines="1"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:textColor="@color/lh_text_secondary"
        android:textColorHint="@color/lh_text_hint"
        android:textSize="15sp" />

    <ImageButton
        android:id="@+id/btnRemoverAlimento"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/remover"
        android:padding="4dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_delete"
        app:tint="@color/lh_text_secondary" />
</LinearLayout>
