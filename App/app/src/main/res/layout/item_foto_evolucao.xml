<?xml version="1.0" encoding="utf-8"?>
<!-- Card de foto do histórico de evolução (grade de 2 colunas no RecyclerView) -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/LH.CardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp">

        <ImageView
            android:id="@+id/ivFoto"
            android:layout_width="0dp"
            android:layout_height="90dp"
            android:background="@drawable/bg_image_placeholder"
            android:contentDescription="@string/historico_evolucao"
            android:padding="18dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_image"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/lh_placeholder" />

        <TextView
            android:id="@+id/tvData"
            style="@style/LH.Text.Body"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_pill"
            android:gravity="center"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivFoto"
            tools:text="11/09/2026" />

        <TextView
            android:id="@+id/tvPeso"
            style="@style/LH.Text.Body"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_pill"
            android:gravity="center"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvData"
            tools:text="Peso: 70kg" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAbrirImagem"
            style="@style/LH.Button.Small"
            android:layout_width="0dp"
            android:layout_marginTop="8dp"
            android:text="@string/abrir_imagem"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvPeso" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
