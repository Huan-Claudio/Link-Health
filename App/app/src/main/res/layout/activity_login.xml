<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: "Login and role selection" -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lh_background"
    android:fillViewport="true"
    tools:context=".ui.auth.LoginActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/lh_screen_padding">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:text="@string/brand_name"
            android:textColor="@color/lh_primary_light"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/brand_slogan"
            android:textColor="@color/lh_text_secondary"
            android:textSize="13sp" />

        <include
            layout="@layout/view_perfil_toggle"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="@dimen/lh_space_l" />

        <LinearLayout
            style="@style/LH.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lh_space_l">

            <TextView
                android:id="@+id/tvLabelLogin"
                style="@style/LH.Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:text="@string/label_email_cpf" />

            <EditText
                android:id="@+id/etLogin"
                style="@style/LH.Input"
                android:autofillHints="emailAddress"
                android:hint="@string/hint_email"
                android:inputType="textEmailAddress" />

            <TextView
                style="@style/LH.Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_senha" />

            <EditText
                android:id="@+id/etSenha"
                style="@style/LH.Input"
                android:autofillHints="password"
                android:hint="@string/hint_senha"
                android:inputType="textPassword" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEntrar"
                style="@style/LH.Button"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/lh_space_m"
                android:text="@string/entrar_no_app" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCriarConta"
                style="@style/LH.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/lh_space_m"
                android:text="@string/criar_nova_conta" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
