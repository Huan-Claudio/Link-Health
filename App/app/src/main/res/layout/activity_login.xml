<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: "Login and role selection" -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lh_background"
    tools:context=".ui.auth.LoginActivity">

    <ScrollView
        android:id="@+id/rolagem"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/lh_screen_padding">

        <TextView
            android:id="@+id/tvMarca"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:text="@string/brand_name"
            android:textColor="@color/lh_primary_light"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvSlogan"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/brand_slogan"
            android:textColor="@color/lh_text_secondary"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvMarca" />

        <include
            android:id="@+id/togglePerfil"
            layout="@layout/view_perfil_toggle"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginTop="@dimen/lh_space_l"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSlogan" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLogin"
            style="@style/LH.CardView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lh_space_l"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/togglePerfil">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/lh_card_padding">

            <TextView
                android:id="@+id/tvLabelLogin"
                style="@style/LH.Text.Label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:text="@string/label_email_cpf"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <EditText
                android:id="@+id/etLogin"
                style="@style/LH.Input"
                android:layout_width="0dp"
                android:layout_marginTop="6dp"
                android:autofillHints="emailAddress"
                android:hint="@string/hint_email"
                android:inputType="textEmailAddress"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvLabelLogin" />

            <TextView
                android:id="@+id/tvLabelSenha"
                style="@style/LH.Text.Label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/label_senha"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/etLogin" />

            <EditText
                android:id="@+id/etSenha"
                style="@style/LH.Input"
                android:layout_width="0dp"
                android:layout_marginTop="6dp"
                android:autofillHints="password"
                android:hint="@string/hint_senha"
                android:inputType="textPassword"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvLabelSenha" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEntrar"
                style="@style/LH.Button"
                android:layout_width="0dp"
                android:layout_marginTop="@dimen/lh_space_m"
                android:text="@string/entrar_no_app"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/etSenha" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCriarConta"
                style="@style/LH.Button.Outlined"
                android:layout_width="0dp"
                android:layout_marginTop="@dimen/lh_space_m"
                android:text="@string/criar_nova_conta"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnEntrar" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
