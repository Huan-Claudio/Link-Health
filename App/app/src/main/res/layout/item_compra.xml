<?xml version="1.0" encoding="utf-8"?>
<!-- Item da lista de compras. O ícone da direita é um "check" (paciente) ou "lixeira" (nutricionista) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_input"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="8dp">

    <TextView
        android:id="@+id/tvDescricao"
        style="@style/LH.Text.Body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        tools:text="3 caixas de ovos" />

    <ImageView
        android:id="@+id/ivAcao"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/lista_compras"
        android:scaleType="fitCenter"
        android:src="@drawable/bg_circle_unchecked" />
</LinearLayout>
