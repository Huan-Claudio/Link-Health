<?xml version="1.0" encoding="utf-8"?>
<!-- Visualização ampliada da foto (2º frame "Linha do tempo de evolução" do Figma) -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/LH.CardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <ImageView
            android:id="@+id/ivImagemGrande"
            android:layout_width="0dp"
            android:layout_height="360dp"
            android:background="@drawable/bg_image_placeholder"
            android:contentDescription="@string/historico_evolucao"
            android:padding="40dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_image"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/lh_placeholder" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFechar"
            style="@style/LH.IconButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_margin="6dp"
            android:contentDescription="@string/voltar"
            app:backgroundTint="@color/lh_placeholder"
            app:cornerRadius="18dp"
            app:icon="@drawable/ic_close"
            app:iconSize="18dp"
            app:iconTint="@color/white"
            app:layout_constraintEnd_toEndOf="@id/ivImagemGrande"
            app:layout_constraintTop_toTopOf="@id/ivImagemGrande" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
