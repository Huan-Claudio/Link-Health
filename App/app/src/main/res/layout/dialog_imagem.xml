<?xml version="1.0" encoding="utf-8"?>
<!-- Visualização ampliada da foto (2º frame "Linha do tempo de evolução" do Figma) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:padding="12dp">

    <ImageView
        android:id="@+id/ivImagemGrande"
        android:layout_width="match_parent"
        android:layout_height="360dp"
        android:background="@drawable/bg_image_placeholder"
        android:contentDescription="@string/historico_evolucao"
        android:padding="40dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_image"
        app:tint="@color/lh_placeholder" />

    <ImageButton
        android:id="@+id/btnFechar"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="top|end"
        android:layout_margin="6dp"
        android:background="@drawable/bg_circle_gray"
        android:contentDescription="@string/voltar"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_close"
        app:tint="@color/white" />
</FrameLayout>
