<?xml version="1.0" encoding="utf-8"?>
<!-- Seletor Nutricionista / Paciente (MaterialButtonToggleGroup controlado pela classe PerfilToggle) -->
<com.google.android.material.button.MaterialButtonToggleGroup xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/togglePerfil"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:background="@drawable/bg_toggle_container"
    android:padding="3dp"
    app:selectionRequired="true"
    app:singleSelection="true">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOpcaoNutricionista"
        style="@style/LH.ToggleButton"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:text="@string/perfil_nutricionista" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOpcaoPaciente"
        style="@style/LH.ToggleButton"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:text="@string/perfil_paciente" />
</com.google.android.material.button.MaterialButtonToggleGroup>
