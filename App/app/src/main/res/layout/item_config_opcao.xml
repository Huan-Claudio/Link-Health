<?xml version="1.0" encoding="utf-8"?>
<!-- Linha de opção da tela de Configurações (ícone em círculo azul + texto) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:layout_marginTop="@dimen/lh_space_s"
    android:background="@drawable/bg_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="12dp">

    <FrameLayout
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_circle_primary">

        <ImageView
            android:id="@+id/ivIcone"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            app:tint="@color/white" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvTitulo"
        style="@style/LH.Text.Body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:textStyle="bold" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/switchOpcao"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:thumbTint="@color/white"
        app:trackTint="@color/switch_track"
        app:trackDecorationTint="@android:color/transparent" />
</LinearLayout>
