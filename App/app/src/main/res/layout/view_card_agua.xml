<?xml version="1.0" encoding="utf-8"?>
<!-- Card "Meta de água ingerida". Os botões de +/- só aparecem para o paciente;
     o botão "Edite a meta" só aparece para o nutricionista. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/LH.CardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/lh_card_padding">

        <TextView
            android:id="@+id/tvTituloAgua"
            style="@style/LH.Text.CardTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/meta_agua"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressAgua"
            style="@style/LH.Progress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTituloAgua" />

        <TextView
            android:id="@+id/tvAgua"
            style="@style/LH.Text.Caption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toStartOf="@id/btnEditarMeta"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/progressAgua"
            tools:text="2L de 5L" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditarMeta"
            style="@style/LH.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginTop="8dp"
            android:minWidth="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="10dp"
            android:text="@string/edite_meta"
            android:textColor="@color/lh_text_primary"
            android:textSize="11sp"
            android:visibility="gone"
            app:icon="@drawable/ic_edit"
            app:iconGravity="end"
            app:iconSize="14dp"
            app:iconTint="@color/lh_text_primary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/progressAgua"
            app:strokeColor="@color/lh_border"
            tools:visibility="visible" />

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barreiraAgua"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="tvAgua,btnEditarMeta" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMenos500"
            style="@style/LH.Button.Chip"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_marginTop="10dp"
            android:text="@string/agua_menos_500"
            app:backgroundTint="@color/lh_yellow"
            app:icon="@drawable/ic_remove"
            app:layout_constraintEnd_toStartOf="@id/btnMenos1L"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/barreiraAgua" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMenos1L"
            style="@style/LH.Button.Chip"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:layout_marginTop="10dp"
            android:text="@string/agua_menos_1l"
            app:backgroundTint="@color/lh_yellow"
            app:icon="@drawable/ic_remove"
            app:layout_constraintEnd_toStartOf="@id/btnMais500"
            app:layout_constraintStart_toEndOf="@id/btnMenos500"
            app:layout_constraintTop_toBottomOf="@id/barreiraAgua" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMais500"
            style="@style/LH.Button.Chip"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:layout_marginTop="10dp"
            android:text="@string/agua_mais_500"
            app:backgroundTint="@color/lh_green_dark"
            app:icon="@drawable/ic_add"
            app:layout_constraintEnd_toStartOf="@id/btnMais1L"
            app:layout_constraintStart_toEndOf="@id/btnMenos1L"
            app:layout_constraintTop_toBottomOf="@id/barreiraAgua" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMais1L"
            style="@style/LH.Button.Chip"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:layout_marginTop="10dp"
            android:text="@string/agua_mais_1l"
            app:backgroundTint="@color/lh_green_dark"
            app:icon="@drawable/ic_add"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnMais500"
            app:layout_constraintTop_toBottomOf="@id/barreiraAgua" />

        <!-- Grupo usado para esconder todos os botões de água de uma vez (tela do nutricionista) -->
        <androidx.constraintlayout.widget.Group
            android:id="@+id/layoutBotoesAgua"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="btnMenos500,btnMenos1L,btnMais500,btnMais1L" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
