<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/LH.CardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/lh_card_padding">
        <TextView
            android:id="@+id/tvTituloAgua"
            style="@style/LH.Text.CardTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/meta_agua"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressAgua"
            style="@style/LH.Progress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:indeterminate="false"
            android:max="100"
            app:indicatorColor="@color/lh_green"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTituloAgua" />
        <TextView
            android:id="@+id/tvAgua"
            style="@style/LH.Text.Caption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnEditarMeta"
            app:layout_constraintTop_toBottomOf="@id/progressAgua" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditarMeta"
            style="@style/LH.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Editar meta"
            android:textSize="11sp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/progressAgua" />
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barreiraAgua"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="tvAgua,btnEditarMeta" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMais500"
            style="@style/LH.Button.Chip"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:text="500 ml"
            app:icon="@drawable/ic_add"
            app:backgroundTint="@color/lh_green_dark"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnMais1L"
            app:layout_constraintTop_toBottomOf="@id/barreiraAgua" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMais1L"
            style="@style/LH.Button.Chip"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_marginTop="12dp"
            android:text="1 L"
            app:icon="@drawable/ic_add"
            app:backgroundTint="@color/lh_green_dark"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@id/btnMais500"
            app:layout_constraintEnd_toStartOf="@id/btnPersonalizado"
            app:layout_constraintTop_toBottomOf="@id/barreiraAgua" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPersonalizado"
            style="@style/LH.Button.Chip"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_marginTop="12dp"
            android:text="Personalizado"
            android:textSize="11sp"
            app:backgroundTint="@color/lh_input"
            android:textColor="@color/lh_text_primary"
            app:layout_constraintHorizontal_weight="1.35"
            app:layout_constraintStart_toEndOf="@id/btnMais1L"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/barreiraAgua" />
        <androidx.constraintlayout.widget.Group
            android:id="@+id/layoutBotoesAgua"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="btnMais500,btnMais1L,btnPersonalizado" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>