<?xml version="1.0" encoding="utf-8"?>
<!-- Card "Meta de água ingerida". Os botões de +/- só aparecem para o paciente;
     o botão "Edite a meta" só aparece para o nutricionista. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/LH.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/lh_space_m">

    <TextView
        style="@style/LH.Text.CardTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/meta_agua" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressAgua"
        style="@style/LH.Progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvAgua"
            style="@style/LH.Text.Caption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditarMeta"
            style="@style/LH.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:minWidth="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="10dp"
            android:text="@string/edite_meta"
            android:textColor="@color/lh_text_primary"
            android:textSize="11sp"
            android:visibility="gone"
            app:icon="@drawable/ic_edit"
            app:iconGravity="end"
            app:iconSize="14dp"
            app:iconTint="@color/lh_text_primary"
            app:strokeColor="@color/lh_border" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutBotoesAgua"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnMenos500"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_chip_yellow"
            android:drawableStart="@drawable/ic_remove"
            android:drawableTint="@color/lh_background"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/agua_menos_500"
            android:textColor="@color/lh_background"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnMenos1L"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip_yellow"
            android:drawableStart="@drawable/ic_remove"
            android:drawableTint="@color/lh_background"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/agua_menos_1l"
            android:textColor="@color/lh_background"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnMais500"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip_green"
            android:drawableStart="@drawable/ic_add"
            android:drawableTint="@color/white"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/agua_mais_500"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnMais1L"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip_green"
            android:drawableStart="@drawable/ic_add"
            android:drawableTint="@color/white"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/agua_mais_1l"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
