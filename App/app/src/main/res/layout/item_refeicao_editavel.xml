<?xml version="1.0" encoding="utf-8"?>
<!-- Card editável de refeição (tela "Editar Plano Alimentar" do nutricionista, item de RecyclerView).
     Os alimentos ficam numa RecyclerView interna. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/LH.CardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/lh_space_m">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Dropdown do tipo de refeição -->
        <TextView
            android:id="@+id/tvTipoRefeicao"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_input"
            android:clickable="true"
            android:drawableEnd="@drawable/ic_arrow_drop_down"
            android:drawablePadding="2dp"
            android:drawableTint="@color/lh_text_secondary"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:minWidth="130dp"
            android:paddingStart="12dp"
            android:paddingEnd="4dp"
            android:textColor="@color/lh_text_secondary"
            android:textSize="15sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Café da manhã" />

        <!-- Horário (abre o relógio nativo) -->
        <TextView
            android:id="@+id/tvHorario"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_input"
            android:clickable="true"
            android:contentDescription="@string/horario_refeicao"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/lh_text_secondary"
            android:textSize="15sp"
            app:layout_constraintStart_toEndOf="@id/tvTipoRefeicao"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="00:00" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRemoverRefeicao"
            style="@style/LH.IconButton"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:contentDescription="@string/remover_refeicao"
            android:translationX="6dp"
            android:translationY="-6dp"
            app:icon="@drawable/ic_delete"
            app:iconSize="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/listaAlimentos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:nestedScrollingEnabled="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTipoRefeicao"
            tools:itemCount="3"
            tools:listitem="@layout/item_alimento_editavel" />

        <include
            android:id="@+id/btnAdicionarAlimento"
            layout="@layout/view_botao_adicionar"
            android:layout_width="0dp"
            android:layout_height="46dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/listaAlimentos" />

        <include
            android:id="@+id/btnSalvarRefeicao"
            layout="@layout/view_botao_salvar"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginTop="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnAdicionarAlimento" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
