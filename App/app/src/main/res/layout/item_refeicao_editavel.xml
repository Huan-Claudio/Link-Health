<?xml version="1.0" encoding="utf-8"?>
<!-- Card editável de refeição (tela "Editar Plano Alimentar" do nutricionista) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/LH.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/lh_space_m"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etNomeRefeicao"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_input"
            android:hint="@string/hint_refeicao"
            android:importantForAutofill="no"
            android:inputType="textCapSentences"
            android:maxLines="1"
            android:minWidth="140dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textColor="@color/lh_text_primary"
            android:textColorHint="@color/lh_text_hint"
            android:textSize="12sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnRemoverRefeicao"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/hint_refeicao"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_delete"
            app:tint="@color/lh_text_secondary" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/containerAlimentos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAdicionarAlimento"
        style="@style/LH.Button.Small"
        android:layout_width="match_parent"
        android:layout_marginTop="4dp"
        android:text="@string/adicionar_alimento" />
</LinearLayout>
