<?xml version="1.0" encoding="utf-8"?>
<!-- Card editável de refeição (tela "Editar Plano Alimentar" do nutricionista) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/LH.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/lh_space_m"
    android:padding="16dp">

    <!-- Dropdown do tipo de refeição + horário + lixeira -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvTipoRefeicao"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_input"
            android:clickable="true"
            android:drawableEnd="@drawable/ic_arrow_drop_down"
            android:drawablePadding="2dp"
            android:drawableTint="@color/lh_text_secondary"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:minWidth="130dp"
            android:paddingStart="12dp"
            android:paddingEnd="4dp"
            android:textColor="@color/lh_text_secondary"
            android:textSize="15sp"
            tools:text="Café da manhã" />

        <TextView
            android:id="@+id/tvHorario"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_input"
            android:clickable="true"
            android:contentDescription="@string/horario_refeicao"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/lh_text_secondary"
            android:textSize="15sp"
            tools:text="00:00" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnRemoverRefeicao"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginTop="-6dp"
            android:layout_marginEnd="-6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/remover_refeicao"
            android:padding="3dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_delete"
            app:tint="@color/lh_text_secondary" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/containerAlimentos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical" />

    <include
        android:id="@+id/btnAdicionarAlimento"
        layout="@layout/view_botao_adicionar" />

    <include
        android:id="@+id/btnSalvarRefeicao"
        layout="@layout/view_botao_salvar" />
</LinearLayout>
