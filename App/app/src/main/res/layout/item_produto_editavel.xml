<?xml version="1.0" encoding="utf-8"?>
<!-- Formulário "Recomendar Produto" (visão do nutricionista) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/LH.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/lh_space_m">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/LH.Text.CardTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/recomendar_produto"
            android:textSize="13sp" />

        <ImageButton
            android:id="@+id/btnRemover"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/recomendar_produto"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_delete"
            app:tint="@color/lh_text_secondary" />
    </LinearLayout>

    <TextView
        style="@style/LH.Text.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_nome_produto" />

    <EditText
        android:id="@+id/etNomeProduto"
        style="@style/LH.Input"
        android:hint="@string/label_nome_produto"
        android:importantForAutofill="no" />

    <TextView
        style="@style/LH.Text.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_preco_produto" />

    <EditText
        android:id="@+id/etPrecoProduto"
        style="@style/LH.Input"
        android:hint="@string/hint_preco"
        android:importantForAutofill="no"
        android:inputType="numberDecimal" />

    <TextView
        style="@style/LH.Text.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_link_compra" />

    <EditText
        android:id="@+id/etLinkProduto"
        style="@style/LH.Input"
        android:hint="@string/hint_link"
        android:importantForAutofill="no"
        android:inputType="textUri" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSalvarProduto"
        style="@style/LH.Button"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="@dimen/lh_space_m"
        android:text="@string/salvar_alteracoes"
        android:textSize="12sp" />
</LinearLayout>
