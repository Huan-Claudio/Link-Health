<?xml version="1.0" encoding="utf-8"?>
<!-- Formulário "Recomendar Produto" (visão do nutricionista, item de RecyclerView) -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/LH.CardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/lh_space_m">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/lh_card_padding">

        <TextView
            android:id="@+id/tvTituloCard"
            style="@style/LH.Text.CardTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/recomendar_produto"
            android:textSize="13sp"
            app:layout_constraintBottom_toBottomOf="@id/btnRemover"
            app:layout_constraintEnd_toStartOf="@id/btnRemover"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/btnRemover" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRemover"
            style="@style/LH.IconButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@string/remover"
            app:icon="@drawable/ic_delete"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvLabelNome"
            style="@style/LH.Text.Label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/label_nome_produto"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnRemover" />

        <EditText
            android:id="@+id/etNomeProduto"
            style="@style/LH.Input"
            android:layout_width="0dp"
            android:layout_marginTop="6dp"
            android:hint="@string/label_nome_produto"
            android:importantForAutofill="no"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvLabelNome" />

        <TextView
            android:id="@+id/tvLabelPreco"
            style="@style/LH.Text.Label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/label_preco_produto"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/etNomeProduto" />

        <EditText
            android:id="@+id/etPrecoProduto"
            style="@style/LH.Input"
            android:layout_width="0dp"
            android:layout_marginTop="6dp"
            android:hint="@string/hint_preco"
            android:importantForAutofill="no"
            android:inputType="numberDecimal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvLabelPreco" />

        <TextView
            android:id="@+id/tvLabelLink"
            style="@style/LH.Text.Label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/label_link_compra"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/etPrecoProduto" />

        <EditText
            android:id="@+id/etLinkProduto"
            style="@style/LH.Input"
            android:layout_width="0dp"
            android:layout_marginTop="6dp"
            android:hint="@string/hint_link"
            android:importantForAutofill="no"
            android:inputType="textUri"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvLabelLink" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSalvarProduto"
            style="@style/LH.Button"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginTop="@dimen/lh_space_m"
            android:text="@string/salvar_alteracoes"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/etLinkProduto" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
