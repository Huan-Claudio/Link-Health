<?xml version="1.0" encoding="utf-8"?>
<!-- Layout genérico: cabeçalho + lista rolável (container preenchido via código).
     Usado por: Meu Plano Alimentar, Registro diário, Produtos Recomendados, Editar Plano. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lh_background"
    android:orientation="vertical"
    android:paddingStart="@dimen/lh_screen_padding"
    android:paddingTop="@dimen/lh_screen_padding"
    android:paddingEnd="@dimen/lh_screen_padding">

    <include layout="@layout/view_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/lh_screen_padding">

        <LinearLayout
            android:id="@+id/container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- Botão fixo no rodapé (opcional, fica oculto por padrão) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRodape"
        style="@style/LH.Button"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/lh_space_s"
        android:layout_marginBottom="@dimen/lh_space_m"
        android:visibility="gone"
        app:backgroundTint="@color/lh_primary_dark" />
</LinearLayout>
