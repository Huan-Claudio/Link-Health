<?xml version="1.0" encoding="utf-8"?>
<!-- Layout genérico: cabeçalho + RecyclerView (+ botão de rodapé opcional).
     Usado por: Meu Plano Alimentar, Lista de Compras (paciente), Registro diário,
     Editar Produtos e Editar Plano Alimentar. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lh_background"
    android:paddingStart="@dimen/lh_screen_padding"
    android:paddingTop="@dimen/lh_screen_padding"
    android:paddingEnd="@dimen/lh_screen_padding"
    tools:context=".ui.paciente.PlanoAlimentarActivity">

    <include
        android:id="@+id/header"
        layout="@layout/view_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/lista"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/lh_screen_padding"
        app:layout_constraintBottom_toTopOf="@id/btnRodape"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header"
        tools:listitem="@layout/item_refeicao_paciente" />

    <!-- Botão fixo no rodapé (opcional, fica oculto por padrão) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRodape"
        style="@style/LH.Button"
        android:layout_width="0dp"
        android:layout_marginTop="@dimen/lh_space_s"
        android:layout_marginBottom="@dimen/lh_space_m"
        android:visibility="gone"
        app:backgroundTint="@color/lh_primary_dark"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="@string/adicionar_produto"
        tools:visibility="visible" />
</androidx.constraintlayout.widget.ConstraintLayout>
