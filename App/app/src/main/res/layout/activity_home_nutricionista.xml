<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: "Home Nutricionista" -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lh_background"
    android:orientation="vertical"
    android:paddingStart="@dimen/lh_screen_padding"
    android:paddingTop="@dimen/lh_screen_padding"
    android:paddingEnd="@dimen/lh_screen_padding"
    tools:context=".ui.nutricionista.HomeNutricionistaActivity">

    <LinearLayout
        android:id="@+id/layoutPerfil"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/tvAvatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_primary"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="DR." />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvOla"
                style="@style/LH.Text.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Olá, Dr. Welington" />

            <TextView
                android:id="@+id/tvPacientesAtivos"
                style="@style/LH.Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="24 Pacientes ativos" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/LH.Text.Section"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/meus_pacientes" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNovoPaciente"
            style="@style/LH.Button.Small"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:text="@string/novo_paciente"
            app:cornerRadius="6dp" />
    </LinearLayout>

    <EditText
        android:id="@+id/etBusca"
        style="@style/LH.Input"
        android:layout_marginTop="@dimen/lh_space_m"
        android:drawableStart="@drawable/ic_search"
        android:drawableTint="@color/lh_text_hint"
        android:hint="@string/buscar_paciente"
        android:importantForAutofill="no"
        android:imeOptions="actionSearch" />

    <TextView
        android:id="@+id/tvVazio"
        style="@style/LH.Text.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/lh_space_m"
        android:text="@string/nenhum_paciente"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/lh_space_m"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/lh_screen_padding">

        <LinearLayout
            android:id="@+id/container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
