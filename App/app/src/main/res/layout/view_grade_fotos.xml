<?xml version="1.0" encoding="utf-8"?>
<!-- Grade 2x2 da tela "Novo registro de evolução": Frente | Costas / Lado direito | Lado esquerdo.
     Cada célula usa view_foto_avaliacao.xml. "Lado esquerdo" fica desabilitado ("Em breve") até o
     servidor aceitar a 4ª foto. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guiaMeio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5" />

    <include
        android:id="@+id/fotoFrente"
        layout="@layout/view_foto_avaliacao"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        app:layout_constraintEnd_toStartOf="@id/guiaMeio"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <include
        android:id="@+id/fotoCostas"
        layout="@layout/view_foto_avaliacao"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/guiaMeio"
        app:layout_constraintTop_toTopOf="parent" />

    <include
        android:id="@+id/fotoLadoDireito"
        layout="@layout/view_foto_avaliacao"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintEnd_toStartOf="@id/guiaMeio"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/fotoFrente" />

    <include
        android:id="@+id/fotoLadoEsquerdo"
        layout="@layout/view_foto_avaliacao"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/guiaMeio"
        app:layout_constraintTop_toBottomOf="@id/fotoCostas" />
</androidx.constraintlayout.widget.ConstraintLayout>
