<?xml version="1.0" encoding="utf-8"?>
<!-- Produto recomendado (visão do paciente, somente leitura + link de compra) -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/LH.CardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/lh_space_m">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/lh_card_padding">

        <TextView
            android:id="@+id/tvTituloCard"
            style="@style/LH.Text.CardTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/produto_recomendado"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvLabelNome"
            style="@style/LH.Text.Label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/label_nome_produto"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTituloCard" />

        <TextView
            android:id="@+id/tvNomeProduto"
            style="@style/LH.Value"
            android:layout_width="0dp"
            android:layout_marginTop="6dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvLabelNome"
            tools:text="Whey Protein Growth" />

        <TextView
            android:id="@+id/tvLabelPreco"
            style="@style/LH.Text.Label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/label_preco_produto"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvNomeProduto" />

        <TextView
            android:id="@+id/tvPrecoProduto"
            style="@style/LH.Value"
            android:layout_width="0dp"
            android:layout_marginTop="6dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvLabelPreco"
            tools:text="R$ 129,90" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnComprar"
            style="@style/LH.Button.Small"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginTop="@dimen/lh_space_m"
            android:text="@string/comprar_produto"
            app:icon="@drawable/ic_open_in_new"
            app:iconGravity="textStart"
            app:iconSize="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvPrecoProduto" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
